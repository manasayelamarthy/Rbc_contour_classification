# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# ── Large binary / data files (images, weights, archives) ─────────────────
# This project works with thousands of microscopy tile images, trained model
# weights, and generated parquet deliverables -- none of these belong in git
# (git isn't built for large binaries, and GitHub has hard file-size limits).
# Only the actual code (scripts, notebooks, configs) should be tracked.
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.pt
*.pth
*.onnx
*.rar
*.zip
*.7z
*.npy
*.npz
*.parquet
*.pdf
*.mp4
*.avi

